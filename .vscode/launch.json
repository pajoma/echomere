{
  // Start the cove scene with F5 (Run and Debug). The pre-launch task builds it first if anything changed.
  // Needs the CodeLLDB extension (vadimcn.vscode-lldb); without it, use Terminal > Run Task > "scene: run
  // preview".
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cove scene",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/scene/target/release/scene-preview",
      "args": [],
      "cwd": "${workspaceFolder}/scene",
      "preLaunchTask": "scene: build preview"
    },
    {
      "name": "Cove scene at noon, with the small school",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/scene/target/release/scene-preview",
      "args": ["--hour", "12", "--school", "small"],
      "cwd": "${workspaceFolder}/scene",
      "preLaunchTask": "scene: build preview"
    },
    {
      "name": "Cove scene, a day in two minutes",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/scene/target/release/scene-preview",
      "args": ["--day-seconds", "120"],
      "cwd": "${workspaceFolder}/scene",
      "preLaunchTask": "scene: build preview"
    }
  ]
}
